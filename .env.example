# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
SITE_URL=https://your-public-site.example.com

# Optional: full AI + audio mode
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
EXPO_PUBLIC_DEBUG_MODE=false

# AI provider runtime split. See apps/default/lib/ai.ts and
# docs/edge-ai-qvac.md §3.5 for context.
#   cloud  - existing Anthropic + ElevenLabs path via Convex (default for web).
#   local  - on-device QVAC SDK path. The QVAC submission build sets this.
#   stub   - native fallback that behaves like "cloud". Safe default while
#            the QVAC integration is still being built.
# Web is always "cloud" regardless of this value. Native defaults to "stub"
# when unset, so a fresh clone builds and runs without the QVAC SDK installed.
EXPO_PUBLIC_AI_PROVIDER=stub

# Optional: Avatar generation (Replicate API)
REPLICATE_API_TOKEN=

# Optional: Structured audit log of QVAC SDK calls.
# When set to "1", apps/default/lib/audit-log.ts writes a JSONL file under
# ${cacheDirectory}futureselves-audit/run-<isoTimestamp>.jsonl capturing
# every model load/unload and every LLM/TTS/STT/embedding call with timing
# and (for LLM) real time-to-first-token via streaming.
# Required by the QVAC hackathon evidence bundle. See docs/audit-log.md.
EXPO_PUBLIC_AUDIT_LOG=

# Optional: Agentic workflow orchestration (The Last Voicemail)
MELIUS_API_KEY=

# RevenueCat — in-app purchases (Shipaton 2026). See docs/shipaton-2026.md.
# Both client keys are safe to leave unset: apps/default/lib/revenuecat.ts
# skips SDK configuration entirely if unset, so the app runs normally with
# the premium ("Awakened") tier simply unpurchasable until configured.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
# Convex-side only (set via `npx convex env set REVENUECAT_WEBHOOK_SECRET ...`,
# not in this file) — must match the Authorization header value configured
# in the RevenueCat dashboard's webhook integration settings.
# REVENUECAT_WEBHOOK_SECRET=

# Optional: OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
APPLE_ID=
APPLE_SECRET=
