{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["ES2020", "DOM"],
        "types": ["node"]
    },
    "include": ["**/*.ts"]
}
