{
  "expo": {
    "name": "Future Selves",
    "slug": "future-selves",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "portrait",
    "icon": "../../assets/images/futureself-icon.png",
    "scheme": "futureself",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.futureselves.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Future Selves uses the microphone to transcribe your spoken check-in responses.",
        "NSSpeechRecognitionUsageDescription": "Future Selves uses speech recognition to convert your voice to text for check-in responses."
      }
    },
    "android": {
      "package": "com.futureselves.app",
      "adaptiveIcon": {
        "foregroundImage": "../../assets/images/futureself-icon.png",
        "backgroundColor": "#080A17"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../../assets/images/futureself-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "../../assets/images/futureself-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080A17"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ad43c81-ef6f-4b65-8ccb-3073448bebfb"
      }
    },
    "owner": "papajams.eth"
  }
}
