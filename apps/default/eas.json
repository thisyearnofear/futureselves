  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AI_PROVIDER": "local",
        "EXPO_PUBLIC_QVAC_DEFAULT_LLM": "LLAMA_3_2_1B_INST_Q4_0",
