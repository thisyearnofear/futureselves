{
  "cli": {
    "version": ">= 20.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AI_PROVIDER": "local"
      },
      "ios": {
        "simulator": true
      }
    },
    "submission": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_AI_PROVIDER": "local"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
